flowchart TD
    %% ================================================================
    %% 1. 카메라 캡처와 최신 프레임 선택
    %% ================================================================
    subgraph CAPTURE_STAGE[1. 카메라 캡처]
        CAMERA_INPUT["입력<br/>USB 카메라 index 0<br/>요청 해상도 640 x 480"]
        CAMERA_OPEN["CameraCapture.open<br/>Linux V4L2 우선<br/>실패하면 기본 OpenCV backend 재시도"]
        CAMERA_READ["전용 캡처 스레드<br/>VideoCapture.read 반복"]
        RAW_FRAME["출력 데이터<br/>frame: BGR uint8 ndarray<br/>shape = H x W x 3<br/>captured_at: monotonic timestamp<br/>sequence: 증가 번호"]
        LATEST_SLOT["최신 프레임 슬롯 1개<br/>새 프레임이 이전 미처리 프레임을 덮어씀"]
        WORKER_FRAME["AI 작업자 입력<br/>가장 최신 frame.copy<br/>과거 프레임은 건너뜀"]

        CAMERA_INPUT --> CAMERA_OPEN --> CAMERA_READ --> RAW_FRAME
        RAW_FRAME --> LATEST_SLOT --> WORKER_FRAME
    end

    %% ================================================================
    %% 2. YOLO TensorRT 사람 검출
    %% ================================================================
    subgraph DETECTION_STAGE[2. YOLO TensorRT 사람 검출]
        DETECTOR_INPUT["입력<br/>BGR frame H x W x 3"]
        LETTERBOX["Letterbox 전처리<br/>scale = min modelW div W, modelH div H<br/>비율 유지 resize<br/>남는 영역 pixel 114로 padding"]
        TO_TENSOR["색상과 축 변환<br/>BGR to RGB<br/>HWC to BCHW<br/>uint8 to float32<br/>0에서 1 범위로 정규화"]
        YOLO_TENSOR["TensorRT 입력<br/>tensor shape = 1 x 3 x modelH x modelW"]
        YOLO_ENGINE["yolo11n-person.engine 추론<br/>COCO class 0 사람 전용"]
        YOLO_RAW["TensorRT 출력<br/>후보별 cx, cy, width, height, confidence"]
        CONF_FILTER["confidence 0.35 이상만 유지"]
        NMS["NMS threshold 0.45<br/>겹치는 낮은 confidence 박스 제거"]
        RESTORE_BOX["좌표 복원<br/>padding 제거 후 scale 역변환<br/>원본 frame 경계로 clip"]
        DETECTION_OUTPUT["출력 데이터<br/>boxes: N x xyxy<br/>scores: N<br/>class: 모두 0"]

        DETECTOR_INPUT --> LETTERBOX --> TO_TENSOR --> YOLO_TENSOR
        YOLO_TENSOR --> YOLO_ENGINE --> YOLO_RAW --> CONF_FILTER --> NMS
        NMS --> RESTORE_BOX --> DETECTION_OUTPUT
    end

    WORKER_FRAME -->|frame| DETECTOR_INPUT

    %% ================================================================
    %% 3. BoT-SORT 단기 추적과 내부 ReID
    %% ================================================================
    subgraph BOTSORT_STAGE[3. BoT-SORT 단기 추적]
        BOTSORT_INPUT["입력<br/>현재 사람 boxes와 scores<br/>원본 BGR frame"]
        FAST_REID["BoT-SORT 내부 ReID<br/>각 Crop을 48 x 96으로 resize<br/>HSV 색상 histogram 128D<br/>윤곽 방향 histogram 9D<br/>결합 및 L2 정규화 137D"]
        MOTION_INFO["이동 정보<br/>Kalman 위치와 속도 예측<br/>Sparse Optical Flow GMC<br/>박스 IoU"]
        DATA_ASSOC["현재 검출과 이전 Track 연결<br/>이동 정보 + IoU + 내부 외형 특징<br/>proximity 0.5<br/>appearance 0.8"]
        TRACK_BUFFER["검출 누락 Track 유지<br/>track_buffer = 30 프레임"]
        BOTSORT_OUTPUT["출력 데이터 PersonDetection 목록<br/>tracker_id: BoT-SORT 원본 ID<br/>box: x, y, width, height<br/>confidence"]

        BOTSORT_INPUT --> FAST_REID --> DATA_ASSOC
        BOTSORT_INPUT --> MOTION_INFO --> DATA_ASSOC
        DATA_ASSOC --> TRACK_BUFFER --> BOTSORT_OUTPUT
    end

    DETECTION_OUTPUT -->|boxes와 scores| BOTSORT_INPUT
    WORKER_FRAME -->|원본 frame| BOTSORT_INPUT

    %% ================================================================
    %% 4. 영구 ID와 OSNet 대상 검증
    %% ================================================================
    subgraph ID_REID_STAGE[4. 영구 ID 결정과 OSNet 검증]
        REGISTRY["Identity Registry<br/>입력 tracker_id<br/>출력 중복 없는 영구 track_id"]
        TRACKER_INPUT["PersonTracker 입력<br/>detections<br/>원본 frame<br/>frame_size = W, H<br/>tracking_enabled<br/>control_step_due"]
        HAS_SELECTION{"선택된 영구 ID가 있는가?"}
        NO_ANGLE["출력<br/>tracking result 없음<br/>각도 계산 안 함"]
        RAW_TARGET_VISIBLE{"선택 ID와 연결된<br/>tracker_id가 현재 보이는가?"}
        REID_DUE{"OSNet 0.5초 검사<br/>주기가 되었는가?"}
        OSNET_VERIFY["0.5초마다 OSNet 검증<br/>선택 Crop을 256 x 128 RGB tensor로 변환<br/>osnet_x0_25.engine 출력 512D<br/>L2 정규화 후 gallery와 cosine 비교"]
        ID_VALID{"유사도 0.75 이상<br/>또는 gallery가 비었는가?"}
        VALID_TARGET["출력<br/>신뢰된 target PersonDetection<br/>box와 영구 ID 확정"]
        LOW_COUNT["낮은 유사도 횟수 증가<br/>해당 descriptor 저장 금지"]
        TWO_LOW{"2회 연속 낮은가?"}
        SCAN_VISIBLE["현재 보이는 모든 사람을 OSNet으로 비교"]
        ALT_MATCH{"다른 tracker_id 후보가<br/>유사도 0.85 이상이고<br/>차순위보다 0.06 이상 높은가?"}
        SWAP_REBIND["ID 교환 교정<br/>기존 영구 ID를 올바른 tracker_id로 이동<br/>현재 프레임 전체 영구 ID 재할당"]
        STOP_TRACK["출력<br/>잘못된 사람 추적 중단<br/>gallery 보호 후 다음 검사에서 재검색"]
        LOST_TIME{"마지막 신뢰 확인 후<br/>60초를 초과했는가?"}
        SHORT_WAIT{"마지막 신뢰 확인 후<br/>1초 미만인가?"}
        WAIT_BOT["BoT-SORT 동일 ID 복귀 대기<br/>조건 충족 시 최대 0.8초 팬 이동 예측"]
        LONG_SCAN["장기 OSNet 검색<br/>현재 모든 후보와 gallery 비교"]
        LONG_MATCH{"최고 후보가 0.85 이상<br/>차순위 마진 0.06 이상<br/>같은 후보 2회 연속인가?"}
        LONG_REBIND["장기 재연결<br/>새 tracker_id를 기존 영구 ID로 재바인딩"]
        EXPIRED["선택과 gallery 삭제<br/>사용자 재선택 필요"]

        BOTSORT_OUTPUT --> REGISTRY --> TRACKER_INPUT --> HAS_SELECTION
        HAS_SELECTION -- 아니오 --> NO_ANGLE
        HAS_SELECTION -- 예 --> RAW_TARGET_VISIBLE

        RAW_TARGET_VISIBLE -- 예 --> REID_DUE
        REID_DUE -- 아니오 --> VALID_TARGET
        REID_DUE -- 예 --> OSNET_VERIFY --> ID_VALID
        ID_VALID -- 예 --> VALID_TARGET
        ID_VALID -- 아니오 --> LOW_COUNT --> TWO_LOW
        TWO_LOW -- 아니오 --> VALID_TARGET
        TWO_LOW -- 예 --> SCAN_VISIBLE --> ALT_MATCH
        ALT_MATCH -- 예 --> SWAP_REBIND --> VALID_TARGET
        ALT_MATCH -- 아니오 --> STOP_TRACK

        RAW_TARGET_VISIBLE -- 아니오 --> LOST_TIME
        LOST_TIME -- 예 --> EXPIRED --> NO_ANGLE
        LOST_TIME -- 아니오 --> SHORT_WAIT
        SHORT_WAIT -- 예 --> WAIT_BOT
        WAIT_BOT -->|같은 tracker_id 복귀| VALID_TARGET
        WAIT_BOT -->|복귀 전이며 이동 예측 가능| PREDICTED_RESULT
        WAIT_BOT -->|이동 예측 불가| NO_ANGLE
        WAIT_BOT -->|1초 경과| LONG_SCAN
        SHORT_WAIT -- 아니오 --> LONG_SCAN
        LONG_SCAN --> LONG_MATCH
        LONG_MATCH -- 예 --> LONG_REBIND --> VALID_TARGET
        LONG_MATCH -- 아니오 --> STOP_TRACK
    end

    %% ================================================================
    %% 5. 신뢰 대상의 OSNet gallery 저장 조건
    %% ================================================================
    subgraph GALLERY_STAGE[5. OSNet 특징 Gallery 갱신]
        HAS_DESCRIPTOR{"이번 0.5초 주기에<br/>신뢰된 512D descriptor가 있는가?"}
        TOUCH_EDGE{"target box가 화면 경계에 닿았는가?<br/>x 또는 y가 0 이하<br/>right 또는 bottom이 frame 끝 이상"}
        HEAVY_OVERLAP{"다른 사람과 심하게 겹쳤는가?<br/>intersection div smaller_box_area<br/>0.5 이상"}
        SAVE_GALLERY["descriptor 복사 저장<br/>deque가 최신 20개까지만 유지"]
        SKIP_GALLERY["gallery 저장 생략<br/>현재 프레임의 ID 검증 결과는 유지"]

        VALID_TARGET --> HAS_DESCRIPTOR
        HAS_DESCRIPTOR -- 아니오 --> BOX_HISTORY
        HAS_DESCRIPTOR -- 예 --> TOUCH_EDGE
        TOUCH_EDGE -- 예 --> SKIP_GALLERY
        TOUCH_EDGE -- 아니오 --> HEAVY_OVERLAP
        HEAVY_OVERLAP -- 예 --> SKIP_GALLERY
        HEAVY_OVERLAP -- 아니오 --> SAVE_GALLERY
        SKIP_GALLERY --> BOX_HISTORY
        SAVE_GALLERY --> BOX_HISTORY
    end

    %% ================================================================
    %% 6. 박스 안정화와 조준 좌표 계산
    %% ================================================================
    subgraph AIM_STAGE[6. 선택 대상 박스와 조준 좌표 계산]
        BOX_HISTORY["입력<br/>신뢰 target.box = x, y, width, height"]
        MEDIAN_BOX["최근 3개 target box의 요소별 median<br/>출력 stable x, y, width, height"]
        HEAD_POINT["측정 조준점 계산<br/>measured_x = x + width div 2<br/>measured_y = y + height times 0.10"]
        EMA["화면 표시용 EMA 좌표<br/>filtered = 0.15 times measured<br/>plus 0.85 times previous_filtered"]
        AIM_OUTPUT["출력 데이터<br/>filtered center x, y<br/>빨간 조준점과 상태 표시에 사용"]

        BOX_HISTORY --> MEDIAN_BOX --> HEAD_POINT --> EMA --> AIM_OUTPUT
    end

    %% ================================================================
    %% 7. 팬 오차와 틸트 오차 계산
    %% ================================================================
    subgraph ERROR_STAGE[7. 화면 안전 영역 기준 제어 오차 계산]
        CONTROL_INPUT["입력<br/>stable box x, right = x + width<br/>head_y = y + height times 0.10<br/>frame width W, height H"]
        PAN_BAND["팬 수평 경계 판정<br/>이동 시작: left 0.22W 미만 또는 right 0.78W 초과<br/>정지 복귀: left 0.30W 이상 및 right 0.70W 이하"]
        TILT_BAND["틸트 머리 높이 판정<br/>이동 시작: head_y 0.22H 미만 또는 0.42H 초과<br/>정지 복귀: 0.28H에서 0.36H 사이"]
        PAN_CONFIRM["팬 방향 확정<br/>같은 방향 이탈 2프레임 연속<br/>복귀 후 0.1초 settle<br/>좌우 경계를 모두 넘는 큰 박스는 이동 안 함"]
        TILT_CONFIRM["틸트 방향 확정<br/>같은 방향 이탈 2프레임 연속<br/>복귀 후 0.1초 settle"]
        PAN_ERROR["출력 pan_error<br/>왼쪽 = min 0, (left - 0.30W) / (W/2)<br/>오른쪽 = max 0, (right - 0.70W) / (W/2)"]
        TILT_ERROR["출력 tilt_error<br/>위 = min 0, (head_y - 0.28H) / (H/2)<br/>아래 = max 0, (head_y - 0.36H) / (H/2)"]

        HEAD_POINT --> CONTROL_INPUT
        CONTROL_INPUT --> PAN_BAND --> PAN_CONFIRM --> PAN_ERROR
        CONTROL_INPUT --> TILT_BAND --> TILT_CONFIRM --> TILT_ERROR
    end

    %% ================================================================
    %% 8. 오차를 서보 각도로 변환
    %% ================================================================
    subgraph ANGLE_STAGE[8. 팬과 틸트 최종 각도 계산]
        ANGLE_INPUT["입력<br/>현재 pan과 tilt 각도<br/>pan_error와 tilt_error<br/>tracking_enabled<br/>UART open<br/>0.1초 제어 주기 도달 여부"]
        CAN_UPDATE{"추적 ON이며 UART가 열렸고<br/>0.1초 제어 주기인가?"}
        KEEP_ANGLE["각도 유지<br/>오차는 계산해도 현재 각도 변경 없음"]
        ERROR_TO_STEP["축별 step 계산<br/>step = clamp error times gain 6, -3, 3<br/>0이 아닌 작은 step은 최소 절댓값 1도"]
        APPLY_SIGN["장착 방향 적용<br/>pan_sign = -1<br/>tilt_sign = -1<br/>new_angle = current + sign times step"]
        LIMIT_ROUND["물리 범위 제한과 정수화<br/>각 축 0도에서 180도로 clip<br/>round 처리"]
        ANGLE_OUTPUT["최종 출력 PersonTrackingResult<br/>center: filtered x, y<br/>pan_angle: int<br/>tilt_angle: int<br/>angles_changed: bool<br/>target, state, similarity"]

        PAN_ERROR --> ANGLE_INPUT
        TILT_ERROR --> ANGLE_INPUT
        ANGLE_INPUT --> CAN_UPDATE
        CAN_UPDATE -- 아니오 --> KEEP_ANGLE --> ANGLE_OUTPUT
        CAN_UPDATE -- 예 --> ERROR_TO_STEP --> APPLY_SIGN --> LIMIT_ROUND --> ANGLE_OUTPUT
    end

    %% 선택 대상 유실 시 박스 제어와 별도로 동작하는 짧은 팬 예측 경로
    PREDICTED_RESULT["유실 이동 예측 출력<br/>최근 수평 속도와 방향 사용<br/>최대 0.8초, 추가 이동 최대 15도<br/>한 제어 주기당 최대 3도<br/>tilt는 현재 각도 유지"]
    PREDICTED_RESULT --> ANGLE_OUTPUT

    ANGLE_OUTPUT -. 이후 단계 .-> PACKET["팬 packet target 01<br/>틸트 packet target 02<br/>각도 변경 시 UART mailbox 전달"]
