flowchart TD
    START([새 카메라 프레임]) --> YOLO[YOLO TensorRT 사람 검출]
    YOLO --> NMS[NMS로 중복 검출 제거]
    NMS --> FAST_FEATURE[각 인물 Crop에서 빠른 외형 특징 추출<br/>HSV 색상 + 윤곽 질감]
    FAST_FEATURE --> BOTSORT[BoT-SORT 단기 연결<br/>Kalman 이동 예측 + IoU + GMC + 내부 ReID<br/>track_buffer = 30 프레임]
    BOTSORT --> RAW_ID[BoT-SORT 원본 tracker_id 생성]
    RAW_ID --> ID_REGISTRY[Identity Registry<br/>tracker_id를 고유한 영구 track_id에 일대일 연결]
    ID_REGISTRY --> SELECTED{사용자가 선택한<br/>영구 ID가 있는가?}

    SELECTED -- 아니오 --> OUTPUT[박스와 영구 ID를 웹 화면에 출력]
    SELECTED -- 예 --> TARGET_VISIBLE{선택 대상의<br/>BoT-SORT tracker_id가 보이는가?}

    TARGET_VISIBLE -- 예 --> OSNET_DUE{OSNet 검사 주기<br/>0.5초가 되었는가?}
    OSNET_DUE -- 아니오 --> CONTROL[선택 박스로 팬틸트 목표 계산]
    OSNET_DUE -- 예 --> EXTRACT_SELECTED[선택 Crop의 OSNet 512D 특징 추출]
    EXTRACT_SELECTED --> GALLERY_EMPTY{갤러리가 비어 있는가?}
    GALLERY_EMPTY -- 예 --> TRUSTED[현재 대상을 신뢰]
    GALLERY_EMPTY -- 아니오 --> GUARD{기존 갤러리 유사도<br/>0.75 이상인가?}
    GUARD -- 예 --> TRUSTED
    GUARD -- 아니오 --> BLOCK_SAMPLE[현재 Crop 갤러리 저장 금지<br/>연속 불일치 횟수 증가]
    BLOCK_SAMPLE --> MISMATCH_COUNT{2회 연속<br/>불일치인가?}
    MISMATCH_COUNT -- 아니오 --> VERIFY_CONTROL[ID 검증 중 상태로<br/>현재 추적을 임시 유지]
    MISMATCH_COUNT -- 예 --> SCAN_ALL_SWAP[현재 보이는 모든 사람의<br/>OSNet 특징을 다시 비교]
    SCAN_ALL_SWAP --> SWAP_MATCH{다른 tracker_id가<br/>유사도 0.85 이상이며<br/>차순위보다 0.06 이상 높은가?}
    SWAP_MATCH -- 아니오 --> STOP_WRONG[ID 교환 의심 상태<br/>팬틸트 정지 + 갤러리 보호]
    STOP_WRONG -->|다음 0.5초 검사 주기| SCAN_ALL_SWAP
    SWAP_MATCH -- 예 --> REBIND_SWAP[기존 영구 ID를 올바른 tracker_id에 재바인딩<br/>현재 프레임 전체 ID 재할당]
    REBIND_SWAP --> TRUSTED

    TARGET_VISIBLE -- 아니오 --> TIMEOUT{마지막 신뢰 확인 후<br/>60초를 초과했는가?}
    TIMEOUT -- 예 --> CLEAR[선택과 OSNet 갤러리 삭제<br/>사용자 재선택 요청]
    CLEAR --> OUTPUT
    TIMEOUT -- 아니오 --> SHORT_DELAY{마지막 확인 후<br/>1초 이상 지났는가?}
    SHORT_DELAY -- 아니오 --> BOT_WAIT[BoT-SORT 단기 복귀 대기<br/>가능하면 팬 이동 예측]
    BOT_WAIT --> OUTPUT
    SHORT_DELAY -- 예 --> SCAN_ALL_LONG[현재 보이는 모든 사람을<br/>OSNet 갤러리와 비교]
    SCAN_ALL_LONG --> LONG_MATCH{최고 후보 유사도 0.85 이상<br/>차순위 마진 0.06 이상인가?}
    LONG_MATCH -- 아니오 --> LOST[대상 유실 상태<br/>후보 재검색]
    LOST --> OUTPUT
    LONG_MATCH -- 예 --> CONFIRM{같은 후보가<br/>2회 연속 일치했는가?}
    CONFIRM -- 아니오 --> REID_WAIT[장기 ReID 확인 중]
    REID_WAIT --> OUTPUT
    CONFIRM -- 예 --> REBIND_LONG[새 tracker_id를 기존 영구 ID에 재바인딩<br/>현재 프레임 전체 ID 재할당]
    REBIND_LONG --> TRUSTED

    TRUSTED --> SAMPLE_DUE{이번 프레임에<br/>OSNet 특징이 추출됐는가?}
    SAMPLE_DUE -- 아니오 --> CONTROL
    SAMPLE_DUE -- 예 --> EDGE{박스가 화면 경계에<br/>닿았는가?}
    EDGE -- 예 --> REJECT_SAMPLE[갤러리에 저장하지 않음]
    EDGE -- 아니오 --> OVERLAP{다른 사람과 작은 박스 기준<br/>50% 이상 겹쳤는가?}
    OVERLAP -- 예 --> REJECT_SAMPLE
    OVERLAP -- 아니오 --> SAVE[OSNet 특징을 갤러리에 저장<br/>최신 20개까지만 유지]
    SAVE --> CONTROL
    REJECT_SAMPLE --> CONTROL

    VERIFY_CONTROL --> CONTROL
    CONTROL --> SERVO{추적 기능이 켜져 있고<br/>목표 각도가 변했는가?}
    SERVO -- 예 --> UART[UART 메일박스로 팬틸트 명령 전달]
    SERVO -- 아니오 --> OUTPUT
    UART --> OUTPUT
    OUTPUT --> END([다음 최신 프레임 처리])

    subgraph SHORT_TERM[단기 추적 영역]
        FAST_FEATURE
        BOTSORT
        RAW_ID
    end

    subgraph LONG_TERM[OSNet 검증 및 장기 재식별 영역]
        EXTRACT_SELECTED
        SCAN_ALL_SWAP
        SCAN_ALL_LONG
        SAVE
    end

    subgraph ID_LAYER[ID 중복 방지 영역]
        ID_REGISTRY
        REBIND_SWAP
        REBIND_LONG
    end
